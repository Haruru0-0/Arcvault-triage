# Copy to .env and fill in. .env is gitignored.

# n8n public API (localhost only). Settings -> n8n API -> Create an API key.
N8N_API_KEY=
N8N_BASE_URL=http://localhost:5678

# Filled in after the workflow is created.
N8N_WORKFLOW_ID=

# Needed only by scripts/test-prompts.mjs, which calls DeepSeek directly.
# The n8n workflow itself uses n8n's stored "DeepSeek account" credential.
DEEPSEEK_API_KEY=
